# ============================================================
# FinOps Hub — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ============================================================

# --- Azure Tenant & Subscription ---
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SUBSCRIPTION_ID_SECONDARY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Resource Group ---
RESOURCE_GROUP=RG-<ENV>-<TEAM>-FINOPS

# --- ADLS Gen2 ---
ADLS_ACCOUNT_NAME=<storageaccountname>

# --- Azure Data Factory ---
ADF_NAME=<adf-resource-name>

# --- Azure Data Explorer ---
ADX_CLUSTER_NAME=<adx-cluster-name>
ADX_CLUSTER_ENDPOINT=<adx-cluster-name>.<region>.kusto.windows.net

# --- ADF Service Principal (for ADF → ADX linked service) ---
ADF_SP_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ADF_SP_CLIENT_SECRET — stored as secure ADF parameter, never here

# --- EA Billing ---
EA_BILLING_ACCOUNT_ID=<enrollment-number>

# --- SharePoint ---
SHAREPOINT_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
SHAREPOINT_LIST_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Power BI ---
PBI_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PBI_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PBI_REPORT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PBI_SERVICE_ACCOUNT=<service-account-upn>
